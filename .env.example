# Copie para .env.local:  cp .env.example .env.local

# URL da API usada pelo servidor do Next (Server Components / Server Actions).
# No docker compose ela vira http://api:3001/api (rede interna).
API_URL=http://localhost:3001/api

# URL da API vista pelo navegador (usada só no redirect do login com Google).
API_PUBLIC_URL=http://localhost:3001/api
